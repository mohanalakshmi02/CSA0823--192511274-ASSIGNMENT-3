# -------------------------------------------------
# 2. NORMALISE PHONE NUMBERS AND EMAILS
# -------------------------------------------------

def normalize_number(number):
    digits = "".join(ch for ch in number if ch.isdigit())

    if len(digits) == 12 and digits.startswith("91"):
        digits = digits[2:]

    return digits


def normalize_email(email):
    return email.strip().lower()


def normalize_name(name):
    return " ".join(name.strip().lower().split())


# -------------------------------------------------
# 3. MERGE CONTACTS USING DICTIONARIES AND SETS
# -------------------------------------------------

def merge_contacts(contacts):

    # Main dictionary stores merged contact groups
    merged = {}

    # Indexes connect phone numbers and emails to groups
    phone_index = {}
    email_index = {}

    unmatched_count = 0

    for contact in contacts:

        name = contact.get("name", "").strip()

        numbers = {
            normalize_number(number)
            for number in contact.get("numbers", [])
            if normalize_number(number)
        }

        emails = {
            normalize_email(email)
            for email in contact.get("emails", [])
            if normalize_email(email)
        }

        # Find existing groups using phone numbers and emails
        matching_groups = set()

        for number in numbers:
            if number in phone_index:
                matching_groups.add(phone_index[number])

        for email in emails:
            if email in email_index:
                matching_groups.add(email_index[email])

        # Select an existing group or create a new one
        if matching_groups:
            main_key = sorted(matching_groups)[0]

            # Merge any other matching groups
            for old_key in matching_groups:
                if old_key == main_key:
                    continue

                old_group = merged.pop(old_key)

                merged[main_key]["names"].update(
                    old_group["names"]
                )
                merged[main_key]["numbers"].update(
                    old_group["numbers"]
                )
                merged[main_key]["emails"].update(
                    old_group["emails"]
                )

                for key in phone_index:
                    if phone_index[key] == old_key:
                        phone_index[key] = main_key

                for key in email_index:
                    if email_index[key] == old_key:
                        email_index[key] = main_key

        else:
            if numbers:
                main_key = sorted(numbers)[0]

            elif emails:
                main_key = "EMAIL:" + sorted(emails)[0]

            else:
                unmatched_count += 1
                main_key = "UNMATCHED:" + str(unmatched_count)

            merged[main_key] = {
                "names": set(),
                "numbers": set(),
                "emails": set()
            }

        # Add contact details to the selected group
        if name:
            merged[main_key]["names"].add(name)

        merged[main_key]["numbers"].update(numbers)
        merged[main_key]["emails"].update(emails)

        # Update indexes for all available identifiers
        for number in numbers:
            phone_index[number] = main_key

        for email in emails:
            email_index[email] = main_key

    return merged


