# -------------------------------------------------
# 9. GENERATE LARGE CONTACT DATASETS
# -------------------------------------------------

def generate_contacts(size):

    data = []

    for i in range(size):

        number = str(9000000000 + (i // 2))

        contact = {
            "name": "Person " + str(i),
            "numbers": [number],
            "emails": ["person" + str(i // 2) + "@gmail.com"]
        }

        data.append(contact)

    return data


# -------------------------------------------------
