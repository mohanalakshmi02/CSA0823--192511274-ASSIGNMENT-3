print("Contacts | Execution Time (seconds)")

for size in [1000, 100000]:

    data = generate_contacts(size)

    start = time.perf_counter()
    result = merge_contacts(data)
    elapsed = time.perf_counter() - start

    print(size, "|", round(elapsed, 6))
    print("Merged groups:", len(result))


# -------------------------------------------------
# 11. ALTERNATIVE: PAIRWISE COMPARISON
# -------------------------------------------------

def pairwise_duplicate_count(contacts):

    count = 0

    for i in range(len(contacts)):
        for j in range(i + 1, len(contacts)):

            numbers1 = {
                normalize_number(n)
                for n in contacts[i].get("numbers", [])
            }

            numbers2 = {
                normalize_number(n)
                for n in contacts[j].get("numbers", [])
            }

            emails1 = {
                normalize_email(e)
                for e in contacts[i].get("emails", [])
            }

            emails2 = {
                normalize_email(e)
                for e in contacts[j].get("emails", [])
            }

            if (numbers1 & numbers2) or (emails1 & emails2):
                count += 1

    return count


# Pairwise comparison is measured on 1,000 contacts.
# A 100,000-contact pairwise comparison would be very expensive.

small_data = generate_contacts(1000)

start = time.perf_counter()
pair_count = pairwise_duplicate_count(small_data)
pairwise_time = time.perf_counter() - start

print("\nPAIRWISE COMPARISON")
print("Contacts: 1000")
print("Duplicate pairs:", pair_count)
print("Execution time:", round(pairwise_time, 6), "seconds")


